/* Install only in your own private Google Apps Script project. Configuration is
 * generated by PUB INVOICES and stored in Script Properties, never in logs.
 * The project is NOT a public web app and has no doGet/doPost endpoints. */

function installPubGuru() {
  ScriptApp.requireScopes(ScriptApp.AuthMode.FULL, [
    'https://www.googleapis.com/auth/drive.readonly',
    'https://www.googleapis.com/auth/script.external_request',
    'https://www.googleapis.com/auth/script.scriptapp'
  ]);
  pubGuruCall_('probe');
  for (const trigger of ScriptApp.getProjectTriggers()) {
    if (trigger.getHandlerFunction() === 'syncPubGuru') ScriptApp.deleteTrigger(trigger);
  }
  ScriptApp.newTrigger('syncPubGuru').timeBased().everyMinutes(5).create();
  syncPubGuru();
}

function syncPubGuru() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return;
  try {
    const deadline = Date.now() + 4 * 60 * 1000;
    for (let page = 0; page < 6 && Date.now() < deadline; page++) {
      const result = pubGuruCall_('sync');
      if (result.busy || !result.has_more) break;
    }
  } finally { lock.releaseLock(); }
}

function stopPubGuru() {
  for (const trigger of ScriptApp.getProjectTriggers()) {
    if (trigger.getHandlerFunction() === 'syncPubGuru') ScriptApp.deleteTrigger(trigger);
  }
  // Also disconnect the source in PUB INVOICES to invalidate its capability.
}

function pubGuruCall_(action) {
  const properties = PropertiesService.getScriptProperties();
  const url = properties.getProperty('PUB_GURU_ENDPOINT');
  const source = properties.getProperty('PUB_GURU_SOURCE');
  const capability = properties.getProperty('PUB_GURU_TOKEN');
  if (!/^https:\/\/[a-z0-9]+\.supabase\.co\/functions\/v1\/invoice-drive-import$/.test(url || '') ||
    !/^[a-f0-9-]{36}$/i.test(source || '') || !/^[a-f0-9]{64}$/.test(capability || '')) {
    throw new Error('Nejdřív spusť configurePubGuru z nastavení PUB INVOICES.');
  }
  const result = UrlFetchApp.fetch(url, {
    method: 'post', contentType: 'application/json', followRedirects: false, muteHttpExceptions: true,
    headers: {Authorization: 'Bearer ' + capability},
    payload: JSON.stringify({action: action, source_id: source, google_token: ScriptApp.getOAuthToken()})
  });
  // Never include the response body or credentials in a thrown/logged error.
  if (result.getResponseCode() !== 200) throw new Error('Import neodpověděl. Zkontroluj stav v PUB INVOICES a oprávnění Google.');
  return JSON.parse(result.getContentText());
}
